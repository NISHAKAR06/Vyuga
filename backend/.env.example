DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agriprocure
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32bytes_min
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5173

S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=agriprocure-assets
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

SMS_PROVIDER=APP
WHATSAPP_PROVIDER=APP

ENVIRONMENT=development
